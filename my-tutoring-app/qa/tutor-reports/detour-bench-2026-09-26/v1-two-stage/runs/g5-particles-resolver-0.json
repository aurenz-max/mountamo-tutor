    "di-spoken-practice"
  ],
  "modeKind": "none",
  "rationale": "The student has a misconception that particles in solids are completely motionless. A custom visual animation zooming in on particles in a solid provides direct perceptual proof that they constantly jiggle and vibrate in place.",
  "intent": "Generate a dynamic visual showing particles tightly packed in a lattice within a solid (such as an iron block or salt crystal, distinct from the student's ice example) actively vibrating and jiggling in fixed positions, with an option to toggle movement highlights.",
  "pickMs": 3731,
  "content": {
    "type": "custom-visual",
    "instanceId": "g5-particles-detour-custom-visual",
    "data": {
      "type": "custom-web",
      "id": "g5-particles-detour-custom-visual",
      "title": "Vibrating Particles in a Solid",
      "description": "Generate a dynamic visual showing particles tightly packed in a lattice within a solid (such as an iron block or salt crystal, distinct from the student's ice example) actively vibrating and jiggling in fixed positions, with an option to toggle movement highlights.",
      "htmlContent": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Vibrating Particles in a Solid</title>\n  <style>\n    :root {\n      --bg-dark: #0f172a;\n      --bg-surface: #1e293b;\n      --bg-elevated: #334155;\n      --primary: #3b82f6;\n      --primary-light: #60a5fa;\n      --accent: #a855f7;\n      --accent-light: #c084fc;\n      --success: #10b981;\n      --warning: #f59e0b;\n      --danger: #ef4444;\n      --text-primary: #ffffff;\n      --text-secondary: #cbd5e1;\n      --text-muted: #94a3b8;\n      --text-subtle: #64748b;\n      --border-subtle: rgba(255, 255, 255, 0.08);\n      --border-normal: rgba(255, 255, 255, 0.15);\n      --font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      background-color: var(--bg-dark);\n      color: var(--text-secondary);\n      font-family: var(--font-family);\n      line-height: 1.6;\n      padding: 24px 16px;\n      min-height: 100vh;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n    }\n\n    .container {\n      max-width: 1180px;\n      width: 100%;\n      margin: 0 auto;\n      display: flex;\n      flex-direction: column;\n      gap: 24px;\n    }\n\n    /* Header styling */\n    header {\n      background: linear-gradient(135deg, rgba(30, 41, 59, 0.8), rgba(15, 23, 42, 0.9));\n      border: 1px solid var(--border-subtle);\n      border-radius: 20px;\n      padding: 24px 28px;\n      backdrop-filter: blur(12px);\n      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);\n      position: relative;\n      overflow: hidden;\n    }\n\n    header::after {\n      content: '';\n      position: absolute;\n      top: 0;\n      right: 0;\n      width: 280px;\n      height: 100%;\n      background: radial-gradient(circle at top right, rgba(168, 85, 247, 0.18), transparent 70%);\n      pointer-events: none;\n    }\n\n    .badge-bar {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      margin-bottom: 12px;\n      flex-wrap: wrap;\n    }\n\n    .pill-badge {\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n      font-size: 12px;\n      font-weight: 700;\n      text-transform: uppercase;\n      letter-spacing: 0.05em;\n      padding: 4px 12px;\n      border-radius: 9999px;\n      background: rgba(59, 130, 246, 0.15);\n      color: var(--primary-light);\n      border: 1px solid rgba(59, 130, 246, 0.3);\n    }\n\n    .pill-badge.accent {\n      background: rgba(168, 85, 247, 0.15);\n      color: var(--accent-light);\n      border-color: rgba(168, 85, 247, 0.3);\n    }\n\n    h1 {\n      font-size: clamp(26px, 4vw, 36px);\n      font-weight: 800;\n      color: var(--text-primary);\n      letter-spacing: -0.02em;\n      line-height: 1.2;\n      margin-bottom: 8px;\n    }\n\n    .subtitle {\n      font-size: clamp(15px, 2vw, 17px);\n      color: var(--text-secondary);\n      max-width: 800px;\n    }\n\n    /* Key Vocabulary Card Bar */\n    .vocab-strip {\n      display: flex;\n      gap: 12px;\n      overflow-x: auto;\n      padding: 4px 2px 8px 2px;\n      scrollbar-width: thin;\n    }\n\n    .vocab-btn {\n      background: var(--bg-surface);\n      border: 1px solid var(--border-normal);\n      border-radius: 12px;\n      padding: 8px 16px;\n      color: var(--text-primary);\n      font-size: 13px;\n      font-weight: 600;\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      cursor: pointer;\n      white-space: nowrap;\n      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);\n    }\n\n    .vocab-btn:hover {\n      background: var(--bg-elevated);\n      border-color: var(--primary-light);\n      transform: translateY(-2px);\n      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.2);\n    }\n\n    .vocab-btn .dot {\n      width: 8px;\n      height: 8px;\n      border-radius: 50%;\n      background: var(--primary);\n    }\n\n    /* Main Experience Grid */\n    .main-grid {\n      display: grid;\n      grid-template-columns: 1fr;\n      gap: 24px;\n    }\n\n    @media (min-width: 960px) {\n      .main-grid {\n        grid-template-columns: 1.35fr 1fr;\n      }\n    }\n\n    /* Glass Cards */\n    .card {\n      background: rgba(30, 41, 59, 0.65);\n      border: 1px solid var(--border-subtle);\n      border-radius: 20px;\n      padding: 24px;\n      backdrop-filter: blur(14px);\n      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.35);\n      display: flex;\n      flex-direction: column;\n      position: relative;\n    }\n\n    .card-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: 18px;\n      flex-wrap: wrap;\n      gap: 12px;\n    }\n\n    .card-title {\n      font-size: 19px;\n      font-weight: 700;\n      color: var(--text-primary);\n      display: flex;\n      align-items: center;\n      gap: 10px;\n    }\n\n    /* Material Selector Segmented Control */\n    .segmented-control {\n      display: inline-flex;\n      background: rgba(15, 23, 42, 0.7);\n      padding: 4px;\n      border-radius: 12px;\n      border: 1px solid var(--border-subtle);\n    }\n\n    .segment-btn {\n      padding: 6px 14px;\n      font-size: 13px;\n      font-weight: 600;\n      border: none;\n      background: transparent;\n      color: var(--text-muted);\n      border-radius: 8px;\n      cursor: pointer;\n      transition: all 0.2s ease;\n      display: flex;\n      align-items: center;\n      gap: 6px;\n    }\n\n    .segment-btn.active {\n      background: linear-gradient(135deg, var(--primary), var(--accent));\n      color: var(--text-primary);\n      box-shadow: 0 2px 8px rgba(59, 130, 246, 0.4);\n    }\n\n    /* Visualizer Canvas Area */\n    .viewport-wrapper {\n      position: relative;\n      width: 100%;\n      height: 440px;\n      border-radius: 16px;\n      overflow: hidden;\n      background: radial-gradient(circle at center, #1e293b 0%, #090e17 100%);\n      border: 1px solid rgba(255, 255, 255, 0.1);\n      box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.7);\n    }\n\n    canvas {\n      display: block;\n      width: 100%;\n      height: 100%;\n      cursor: crosshair;\n    }\n\n    /* Floating Nanoviewer HUD Elements */\n    .hud-overlay {\n      position: absolute;\n      top: 14px;\n      left: 14px;\n      pointer-events: none;\n      display: flex;\n      flex-direction: column;\n      gap: 6px;\n    }\n\n    .hud-chip {\n      background: rgba(15, 23, 42, 0.75);\n      border: 1px solid rgba(255, 255, 255, 0.15);\n      backdrop-filter: blur(8px);\n      padding: 6px 12px;\n      border-radius: 20px;\n      font-size: 12px;\n      font-weight: 600;\n      color: var(--text-secondary);\n      display: flex;\n      align-items: center;\n      gap: 8px;\n    }\n\n    .hud-pulse {\n      width: 8px;\n      height: 8px;\n      border-radius: 50%;\n      background: var(--success);\n      box-shadow: 0 0 10px var(--success);\n      animation: pulseAnim 1.6s infinite ease-in-out;\n    }\n\n    @keyframes pulseAnim {\n      0%, 100% { opacity: 0.4; transform: scale(0.9); }\n      50% { opacity: 1; transform: scale(1.2); }\n    }\n\n    .canvas-instruction {\n      position: absolute;\n      bottom: 14px;\n      left: 50%;\n      transform: translateX(-50%);\n      background: rgba(15, 23, 42, 0.85);\n      border: 1px solid rgba(255, 255, 255, 0.12);\n      border-radius: 30px;\n      padding: 6px 16px;\n      font-size: 13px;\n      color: var(--text-secondary);\n      pointer-events: none;\n      backdrop-filter: blur(8px);\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      white-space: nowrap;\n    }\n\n    /* Controls Panel */\n    .controls-panel {\n      display: flex;\n      flex-direction: column;\n      gap: 20px;\n    }\n\n    .control-group {\n      background: rgba(15, 23, 42, 0.5);\n      border: 1px solid var(--border-subtle);\n      border-radius: 14px;\n      padding: 16px;\n    }\n\n    .control-label {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      font-size: 14px;\n      font-weight: 600;\n      color: var(--text-primary);\n      margin-bottom: 10px;\n    }\n\n    .meter-val {\n      font-size: 13px;\n      color: var(--accent-light);\n      font-weight: 700;\n      background: rgba(168, 85, 247, 0.1);\n      padding: 2px 10px;\n      border-radius: 6px;\n      border: 1px solid rgba(168, 85, 247, 0.2);\n    }\n\n    /* Slider Design */\n    .slider-track-wrap {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n    }\n\n    .slider-icon {\n      font-size: 18px;\n    }\n\n    input[type=range] {\n      flex: 1;\n      height: 8px;\n      -webkit-appearance: none;\n      background: linear-gradient(90deg, #3b82f6 0%, #a855f7 50%, #ef4444 100%);\n      border-radius: 8px;\n      outline: none;\n    }\n\n    input[type=range]::-webkit-slider-thumb {\n      -webkit-appearance: none;\n      width: 22px;\n      height: 22px;\n      border-radius: 50%;\n      background: #ffffff;\n      border: 3px solid var(--primary);\n      cursor: pointer;\n      box-shadow: 0 0 10px rgba(0,0,0,0.5);\n      transition: transform 0.1s ease;\n    }\n\n    input[type=range]::-webkit-slider-thumb:hover {\n      transform: scale(1.15);\n    }\n\n    /* Toggle Buttons Grid */\n    .toggles-grid {\n      display: grid;\n      grid-template-columns: repeat(2, 1fr);\n      gap: 10px;\n    }\n\n    .toggle-card-btn {\n      background: var(--bg-surface);\n      border: 1px solid var(--border-normal);\n      border-radius: 12px;\n      padding: 12px;\n      color: var(--text-secondary);\n      font-size: 13px;\n      font-weight: 600;\n      cursor: pointer;\n      display: flex;\n      flex-direction: column;\n      align-items: flex-start;\n      gap: 6px;\n      transition: all 0.25s ease;\n      text-align: left;\n    }\n\n    .toggle-card-btn:hover {\n      border-color: var(--primary-light);\n      background: var(--bg-elevated);\n      transform: translateY(-2px);\n    }\n\n    .toggle-card-btn.active {\n      background: rgba(59, 130, 246, 0.18);\n      border-color: var(--primary);\n      color: var(--text-primary);\n      box-shadow: 0 0 16px rgba(59, 130, 246, 0.25);\n    }\n\n    .toggle-card-btn .status-indicator {\n      display: inline-block;\n      font-size: 10px;\n      text-transform: uppercase;\n      padding: 2px 6px;\n      border-radius: 4px;\n      background: rgba(255, 255, 255, 0.1);\n      color: var(--text-muted);\n    }\n\n    .toggle-card-btn.active .status-indicator {\n      background: var(--primary);\n      color: white;\n    }\n\n    /* Real-World Metaphor Box */\n    .metaphor-box {\n      background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(168, 85, 247, 0.1));\n      border: 1px dashed rgba(168, 85, 247, 0.4);\n      border-radius: 14px;\n      padding: 16px;\n      display: flex;\n      gap: 14px;\n      align-items: flex-start;\n    }\n\n    .metaphor-icon {\n      font-size: 28px;\n      line-height: 1;\n    }\n\n    .metaphor-content h4 {\n      font-size: 14px;\n      color: var(--text-primary);\n      margin-bottom: 4px;\n    }\n\n    .metaphor-content p {\n      font-size: 13px;\n      color: var(--text-secondary);\n      line-height: 1.5;\n    }\n\n    /* Learning Mission / Apply Understanding Card */\n    .mission-card {\n      background: linear-gradient(135deg, rgba(30, 41, 59, 0.8), rgba(15, 23, 42, 0.9));\n      border: 1px solid var(--border-normal);\n      border-radius: 20px;\n      padding: 24px;\n    }\n\n    .mission-header {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-bottom: 16px;\n      flex-wrap: wrap;\n      gap: 10px;\n    }\n\n    .mission-tag {\n      background: rgba(16, 185, 129, 0.15);\n      border: 1px solid rgba(16, 185, 129, 0.3);\n      color: #34d399;\n      font-weight: 700;\n      font-size: 12px;\n      padding: 4px 10px;\n      border-radius: 20px;\n      display: flex;\n      align-items: center;\n      gap: 6px;\n    }\n\n    .challenge-box {\n      background: rgba(15, 23, 42, 0.6);\n      border-radius: 14px;\n      padding: 18px;\n      border: 1px solid var(--border-subtle);\n      margin-bottom: 16px;\n    }\n\n    .challenge-question {\n      font-size: 16px;\n      font-weight: 600;\n      color: var(--text-primary);\n      margin-bottom: 14px;\n    }\n\n    .options-grid {\n      display: grid;\n      grid-template-columns: 1fr;\n      gap: 10px;\n    }\n\n    @media (min-width: 640px) {\n      .options-grid {\n        grid-template-columns: repeat(3, 1fr);\n      }\n    }\n\n    .option-btn {\n      background: var(--bg-surface);\n      border: 1px solid var(--border-normal);\n      border-radius: 12px;\n      padding: 14px;\n      color: var(--text-secondary);\n      font-size: 13px;\n      font-weight: 500;\n      cursor: pointer;\n      text-align: left;\n      transition: all 0.25s ease;\n      display: flex;\n      flex-direction: column;\n      gap: 6px;\n    }\n\n    .option-btn:hover {\n      border-color: var(--primary-light);\n      background: var(--bg-elevated);\n      transform: translateY(-2px);\n    }\n\n    .option-btn.correct {\n      background: rgba(16, 185, 129, 0.2) !important;\n      border-color: var(--success) !important;\n      color: white !important;\n      box-shadow: 0 0 16px rgba(16, 185, 129, 0.3);\n    }\n\n    .option-btn.wrong {\n      background: rgba(239, 68, 68, 0.2) !important;\n      border-color: var(--danger) !important;\n      color: white !important;\n      opacity: 0.7;\n    }\n\n    .feedback-banner {\n      display: none;\n      padding: 14px 18px;\n      border-radius: 12px;\n      font-size: 14px;\n      font-weight: 600;\n      animation: fadeIn 0.3s ease forwards;\n      margin-top: 12px;\n    }\n\n    @keyframes fadeIn {\n      from { opacity: 0; transform: translateY(6px); }\n      to { opacity: 1; transform: translateY(0); }\n    }\n\n    /* Modal for Vocabulary */\n    .modal-backdrop {\n      position: fixed;\n      inset: 0;\n      background: rgba(0, 0, 0, 0.75);\n      backdrop-filter: blur(8px);\n      display: none;\n      align-items: center;\n      justify-content: center;\n      z-index: 1000;\n      padding: 20px;\n    }\n\n    .modal-backdrop.active {\n      display: flex;\n    }\n\n    .modal-card {\n      background: var(--bg-surface);\n      border: 1px solid var(--border-normal);\n      border-radius: 20px;\n      padding: 28px;\n      max-width: 480px;\n      width: 100%;\n      position: relative;\n      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);\n      animation: modalSlide 0.25s cubic-bezier(0.4, 0, 0.2, 1);\n    }\n\n    @keyframes modalSlide {\n      from { opacity: 0; transform: scale(0.95) translateY(10px); }\n      to { opacity: 1; transform: scale(1) translateY(0); }\n    }\n\n    .close-modal-btn {\n      position: absolute;\n      top: 18px;\n      right: 18px;\n      background: rgba(255, 255, 255, 0.08);\n      border: none;\n      color: var(--text-muted);\n      width: 32px;\n      height: 32px;\n      border-radius: 50%;\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 16px;\n      transition: all 0.2s ease;\n    }\n\n    .close-modal-btn:hover {\n      background: rgba(255, 255, 255, 0.2);\n      color: white;\n    }\n\n    .modal-icon {\n      font-size: 40px;\n      margin-bottom: 12px;\n    }\n\n    .modal-title {\n      font-size: 22px;\n      color: var(--text-primary);\n      margin-bottom: 8px;\n      font-weight: 700;\n    }\n\n    .modal-desc {\n      color: var(--text-secondary);\n      font-size: 15px;\n      line-height: 1.6;\n      margin-bottom: 16px;\n    }\n\n    .modal-takeaway {\n      background: rgba(59, 130, 246, 0.1);\n      border-left: 4px solid var(--primary);\n      padding: 10px 14px;\n      border-radius: 0 10px 10px 0;\n      font-size: 13px;\n      color: var(--primary-light);\n    }\n  </style>\n</head>\n<body>\n\n  <div class=\"container\">\n    <!-- Header -->\n    <header>\n      <div class=\"badge-bar\">\n        <span class=\"pill-badge\">🔬 Elementary Science • Matter Lab</span>\n        <span class=\"pill-badge accent\">🎯 Learning Goal: Observe Particles in Solids</span>\n      </div>\n      <h1>Vibrating Particles in a Solid</h1>\n      <p class=\"subtitle\">\n        Zoom in closer than a million microscopes! Discover how particles inside solid objects are packed tightly together, constantly jiggling and shaking, but <strong>never leaving their fixed home spots</strong>.\n      </p>\n    </header>\n\n    <!-- Key Concept Quick-Pills (Interactive Vocabulary) -->\n    <div class=\"vocab-strip\">\n      <button class=\"vocab-btn\" data-vocab=\"solid\">\n        <span class=\"dot\" style=\"background:#3b82f6;\"></span>\n        <strong>Solid</strong> (What is it?)\n      </button>\n      <button class=\"vocab-btn\" data-vocab=\"vibrate\">\n        <span class=\"dot\" style=\"background:#a855f7;\"></span>\n        <strong>Vibrate</strong> (Jiggle in place)\n      </button>\n      <button class=\"vocab-btn\" data-vocab=\"fixed\">\n        <span class=\"dot\" style=\"background:#10b981;\"></span>\n        <strong>Fixed Position</strong> (Home base)\n      </button>\n      <button class=\"vocab-btn\" data-vocab=\"lattice\">\n        <span class=\"dot\" style=\"background:#f59e0b;\"></span>\n        <strong>Lattice</strong> (The tight grid)\n      </button>\n    </div>\n\n    <!-- Main Visualizer Area -->\n    <div class=\"main-grid\">\n      \n      <!-- Interactive Nano-Scope View -->\n      <section class=\"card\">\n        <div class=\"card-header\">\n          <div class=\"card-title\">\n            <span>🔬 Ultra-Zoom NanoScope</span>\n          </div>\n          <!-- Material switcher -->\n          <div class=\"segmented-control\" role=\"group\" aria-label=\"Select Solid Material\">\n            <button class=\"segment-btn active\" id=\"btn-iron\" data-material=\"iron\">\n              <span>🔩 Solid Iron</span>\n            </button>\n            <button class=\"segment-btn\" id=\"btn-salt\" data-material=\"salt\">\n              <span>🧂 Salt Crystal</span>\n            </button>\n          </div>\n        </div>\n\n        <!-- Canvas Container -->\n        <div class=\"viewport-wrapper\" id=\"canvas-container\">\n          <canvas id=\"particleCanvas\"></canvas>\n          \n          <div class=\"hud-overlay\">\n            <div class=\"hud-chip\">\n              <div class=\"hud-pulse\"></div>\n              <span id=\"hud-status\">Status: VIBRATING IN PLACE</span>\n            </div>\n            <div class=\"hud-chip\">\n              <span>Magnification: 100,000,000×</span>\n            </div>\n          </div>\n\n          <div class=\"canvas-instruction\">\n            <span>👆 <strong>Click &amp; pull</strong> any particle to feel its tight spring back!</span>\n          </div>\n        </div>\n      </section>\n\n      <!-- Control Deck -->\n      <section class=\"card controls-panel\">\n        <div class=\"card-title\">\n          <span>⚙️ Nano-Lab Controls</span>\n        </div>\n\n        <!-- Temperature Slider -->\n        <div class=\"control-group\">\n          <div class=\"control-label\">\n            <span>🔥 Thermal Energy (Heat)</span>\n            <span class=\"meter-val\" id=\"temp-display\">Room Temp (20°C)</span>\n          </div>\n          <div class=\"slider-track-wrap\">\n            <span class=\"slider-icon\">❄️</span>\n            <input type=\"range\" id=\"tempSlider\" min=\"1\" max=\"100\" value=\"35\" aria-label=\"Temperature slider\">\n            <span class=\"slider-icon\">🔥</span>\n          </div>\n          <div style=\"font-size: 12px; color: var(--text-muted); margin-top: 8px;\">\n            More heat makes them vibrate faster &amp; harder, but notice: <em>they never swap seats!</em>\n          </div>\n        </div>\n\n        <!-- Highlight & Visual Mode Toggles -->\n        <div class=\"control-group\">\n          <div class=\"control-label\">\n            <span>👁️ Visual Discovery Tools</span>\n          </div>\n          <div class=\"toggles-grid\">\n            <button class=\"toggle-card-btn active\" id=\"toggleTrails\">\n              <span style=\"font-size: 16px;\">✨ Motion Trails</span>\n              <span style=\"font-size: 11px; opacity: 0.85;\">See the wiggle path</span>\n              <span class=\"status-indicator\">ON</span>\n            </button>\n\n            <button class=\"toggle-card-btn active\" id=\"toggleAnchors\">\n              <span style=\"font-size: 16px;\">🎯 Home Base Circles</span>\n              <span style=\"font-size: 11px; opacity: 0.85;\">Fixed positions</span>\n              <span class=\"status-indicator\">ON</span>\n            </button>\n\n            <button class=\"toggle-card-btn\" id=\"toggleBonds\">\n              <span style=\"font-size: 16px;\">🔗 Invisible Bonds</span>\n              <span style=\"font-size: 11px; opacity: 0.85;\">Forces holding them</span>\n              <span class=\"status-indicator\">OFF</span>\n            </button>\n\n            <button class=\"toggle-card-btn\" id=\"toggleSpotlight\">\n              <span style=\"font-size: 16px;\">🔦 Track 1 Particle</span>\n              <span style=\"font-size: 11px; opacity: 0.85;\">Focus on one dancer</span>\n              <span class=\"status-indicator\">OFF</span>\n            </button>\n          </div>\n        </div>\n\n        <!-- Concrete Real-World Metaphor -->\n        <div class=\"metaphor-box\">\n          <div class=\"metaphor-icon\">🚌</div>\n          <div class=\"metaphor-content\">\n            <h4>The \"Packed Bus\" Secret:</h4>\n            <p>\n              Imagine riding a bumpy bus where every seat is full! You can wiggle, groove, and bump your knees against your seatmate, but you <strong>cannot walk down the aisle</strong>. That is exactly how particles in a solid behave!\n            </p>\n          </div>\n        </div>\n\n      </section>\n    </div>\n\n    <!-- Apply Your Knowledge Challenge -->\n    <section class=\"mission-card\">\n      <div class=\"mission-header\">\n        <div style=\"display:flex; align-items:center; gap: 10px;\">\n          <span style=\"font-size: 24px;\">🎯</span>\n          <div>\n            <h3 style=\"color: var(--text-primary); font-size: 18px;\">Apply What You Observed!</h3>\n            <p style=\"font-size: 13px; color: var(--text-muted);\">Test your scientist eyes with this quick observation question.</p>\n          </div>\n        </div>\n        <div class=\"mission-tag\">\n          <span>⭐ Mission 1 of 1</span>\n        </div>\n      </div>\n\n      <div class=\"challenge-box\">\n        <div class=\"challenge-question\" id=\"challenge-q\">\n          Look at the motion trails and home base circles. What happens to a particle as time passes?\n        </div>\n        <div class=\"options-grid\">\n          <button class=\"option-btn\" data-answer=\"wrong1\">\n            <strong>A. It wanders across the block</strong>\n            <span style=\"font-size: 11px; color: var(--text-muted);\">It drifts slowly to the other side</span>\n          </button>\n          <button class=\"option-btn\" data-answer=\"correct\">\n            <strong>B. It vibrates around one fixed spot</strong>\n            <span style=\"font-size: 11px; color: var(--text-muted);\">It wiggles constantly but stays home</span>\n          </button>\n          <button class=\"option-btn\" data-answer=\"wrong2\">\n            <strong>C. It sits completely frozen still</strong>\n            <span style=\"font-size: 11px; color: var(--text-muted);\">It doesn't move or shake at all</span>\n          </button>\n        </div>\n        <div class=\"feedback-banner\" id=\"feedback\"></div>\n      </div>\n    </section>\n  </div>\n\n  <!-- Interactive Vocabulary Dialog -->\n  <div class=\"modal-backdrop\" id=\"vocabModal\">\n    <div class=\"modal-card\">\n      <button class=\"close-modal-btn\" id=\"closeModal\">✕</button>\n      <div class=\"modal-icon\" id=\"m-icon\">🧱</div>\n      <h3 class=\"modal-title\" id=\"m-title\">Solid</h3>\n      <p class=\"modal-desc\" id=\"m-desc\">A state of matter that keeps its own shape and size because its particles are locked closely together.</p>\n      <div class=\"modal-takeaway\" id=\"m-takeaway\">Key Rule: Solids don't flow like liquids or drift like gases!</div>\n    </div>\n  </div>\n\n  <script>\n    document.addEventListener('DOMContentLoaded', () => {\n      // --- CANVAS & SIMULATION SETUP ---\n      const canvas = document.getElementById('particleCanvas');\n      const ctx = canvas.getContext('2d');\n      const container = document.getElementById('canvas-container');\n\n      let width = (canvas.width = container.clientWidth);\n      let height = (canvas.height = container.clientHeight);\n\n      // Simulation States\n      let currentMaterial = 'iron'; // 'iron' or 'salt'\n      let temperature = 35; // 1 to 100\n      let showTrails = true;\n      let showAnchors = true;\n      let showBonds = false;\n      let showSpotlight = false;\n      \n      // Selected/Dragged particle\n      let draggedParticle = null;\n      let mousePos = { x: 0, y: 0 };\n      let isMouseDown = false;\n\n      // Particle Data\n      let particles = [];\n      const COLS = 8;\n      const ROWS = 6;\n      let spotlightIndex = Math.floor((ROWS * COLS) / 2) + Math.floor(COLS / 2);\n\n      // Vocabulary details library\n      const vocabData = {\n        solid: {\n          icon: '🧱',\n          title: 'What is a Solid?',\n          desc: 'A solid is anything with a fixed shape and volume (like an iron hammer, a salt grain, or a wooden desk). It holds its shape because its building blocks are glued together by strong electrical attractions.',\n          takeaway: 'Takeaway: A solid does not pour or spread out to fill a room!'\n        },\n        vibrate: {\n          icon: '⚡',\n          title: 'Vibrate (Jiggling in Place)',\n          desc: 'Particles are NEVER completely stationary! Even in hard steel, every atom is humming, bouncing, and vibrating back and forth millions of times every single second.',\n          takeaway: 'Takeaway: Heat is just vibration energy! Hotter = faster jiggling.'\n        },\n        fixed: {\n          icon: '🎯',\n          title: 'Fixed Position (Assigned Seat)',\n          desc: 'Each particle in a solid has an \"Anchor Spot\". They can dance, lean, and shake inside their spot, but strong neighbor forces yank them right back if they try to move away.',\n          takeaway: 'Takeaway: Particles in solids do not switch places with each other!'\n        },\n        lattice: {\n          icon: '📐',\n          title: 'Lattice (The Neat Pattern)',\n          desc: 'In crystals like salt and iron, particles line up in ultra-neat, tidy 3D geometric grids called a lattice. It looks like an orderly stack of cannonballs or fruit at a grocery store.',\n          takeaway: 'Takeaway: Orderly packing allows maximum particles in minimum space!'\n        }\n      };\n\n      // Particle Class\n      class Particle {\n        constructor(col, row, baseX, baseY, type = 'iron') {\n          this.col = col;\n          this.row = row;\n          this.baseX = baseX;\n          this.baseY = baseY;\n          this.x = baseX;\n          this.y = baseY;\n          this.vx = 0;\n          this.vy = 0;\n          this.type = type; // 'iron', 'na' (sodium), 'cl' (chlorine)\n          \n          // Phase offsets for organic asynchronous vibration\n          this.phaseX = Math.random() * Math.PI * 2;\n          this.phaseY = Math.random() * Math.PI * 2;\n          this.speedX = 0.08 + Math.random() * 0.04;\n          this.speedY = 0.08 + Math.random() * 0.04;\n          \n          // Motion trail buffer\n          this.history = [];\n          this.maxHistory = 18;\n          \n          // Physical appearance\n          this.updateAttributes();\n        }\n\n        updateAttributes() {\n          if (this.type === 'iron') {\n            this.radius = Math.min(width, height) * 0.042;\n            this.colorMain = '#94a3b8';\n            this.colorLight = '#e2e8f0';\n            this.colorDark = '#334155';\n            this.label = 'Fe';\n          } else if (this.type === 'na') {\n            // Sodium: smaller, violet-blue\n            this.radius = Math.min(width, height) * 0.035;\n            this.colorMain = '#818cf8';\n            this.colorLight = '#c7d2fe';\n            this.colorDark = '#4338ca';\n            this.label = 'Na⁺';\n          } else {\n            // Chlorine: larger, emerald green\n            this.radius = Math.min(width, height) * 0.048;\n            this.colorMain = '#34d399';\n            this.colorLight = '#a7f3d0';\n            this.colorDark = '#065f46';\n            this.label = 'Cl⁻';\n          }\n        }\n\n        update(time) {\n          // If being dragged by student\n          if (draggedParticle === this) {\n            const dx = mousePos.x - this.x;\n            const dy = mousePos.y - this.y;\n            this.x += dx * 0.35;\n            this.y += dy * 0.35;\n          } else {\n            // Calculate natural vibration relative to temperature\n            // Temperature scales amplitude (0.8px to 14px) and frequency\n            const vibAmp = (temperature / 100) * (this.radius * 0.45) + 1.2;\n            const vibFreq = 1.0 + (temperature / 100) * 2.2;\n\n            // Harmonious yet chaotic jitter\n            const targetX = this.baseX + Math.sin(time * this.speedX * vibFreq + this.phaseX) * vibAmp \n                            + (Math.sin(time * 0.3 + this.phaseY) * (vibAmp * 0.25));\n            const targetY = this.baseY + Math.cos(time * this.speedY * vibFreq + this.phaseY) * vibAmp\n                            + (Math.cos(time * 0.25 + this.phaseX) * (vibAmp * 0.25));\n\n            // Spring return back to base position with damping\n            const springK = 0.22;\n            const damping = 0.72;\n\n            const ax = (targetX - this.x) * springK;\n            const ay = (targetY - this.y) * springK;\n\n            this.vx = (this.vx + ax) * damping;\n            this.vy = (this.vy + ay) * damping;\n\n            this.x += this.vx;\n            this.y += this.vy;\n          }\n\n          // Update motion trail\n          this.history.push({ x: this.x, y: this.y });\n          if (this.history.length > this.maxHistory) {\n            this.history.shift();\n          }\n        }\n\n        drawAnchor(ctx) {\n          // Visual confirmation of \"Fixed Position\": Home boundary ring\n          ctx.save();\n          ctx.beginPath();\n          ctx.arc(this.baseX, this.baseY, this.radius * 1.35, 0, Math.PI * 2);\n          ctx.strokeStyle = 'rgba(168, 85, 247, 0.25)';\n          ctx.setLineDash([4, 4]);\n          ctx.lineWidth = 1.5;\n          ctx.stroke();\n\n          // Center target pin\n          ctx.beginPath();\n          ctx.arc(this.baseX, this.baseY, 2.5, 0, Math.PI * 2);\n          ctx.fillStyle = 'rgba(168, 85, 247, 0.6)';\n          ctx.fill();\n          ctx.restore();\n        }\n\n        drawTrail(ctx, isFocused) {\n          if (this.history.length < 2) return;\n          ctx.save();\n          ctx.beginPath();\n          ctx.moveTo(this.history[0].x, this.history[0].y);\n          for (let i = 1; i < this.history.length; i++) {\n            ctx.lineTo(this.history[i].x, this.history[i].y);\n          }\n          ctx.strokeStyle = isFocused \n            ? 'rgba(236, 72, 153, 0.9)' \n            : (this.type === 'cl' ? 'rgba(52, 211, 153, 0.45)' : 'rgba(96, 165, 250, 0.45)');\n          ctx.lineWidth = isFocused ? 3 : 1.8;\n          ctx.lineCap = 'round';\n          ctx.lineJoin = 'round';\n          ctx.stroke();\n          ctx.restore();\n        }\n\n        draw(ctx, isFocused, isMuted) {\n          ctx.save();\n\n          const alpha = isMuted ? 0.25 : 1.0;\n          ctx.globalAlpha = alpha;\n\n          // Spotlight halo\n          if (isFocused) {\n            ctx.beginPath();\n            ctx.arc(this.x, this.y, this.radius * 1.9, 0, Math.PI * 2);\n            ctx.fillStyle = 'rgba(236, 72, 153, 0.25)';\n            ctx.fill();\n\n            ctx.beginPath();\n            ctx.arc(this.x, this.y, this.radius * 1.5, 0, Math.PI * 2);\n            ctx.strokeStyle = '#f472b6';\n            ctx.lineWidth = 2;\n            ctx.stroke();\n          }\n\n          // Particle Sphere 3D gradient\n          const grad = ctx.createRadialGradient(\n            this.x - this.radius * 0.35,\n            this.y - this.radius * 0.35,\n            this.radius * 0.1,\n            this.x,\n            this.y,\n            this.radius\n          );\n          grad.addColorStop(0, '#ffffff');\n          grad.addColorStop(0.2, this.colorLight);\n          grad.addColorStop(0.7, this.colorMain);\n          grad.addColorStop(1, this.colorDark);\n\n          // Drop shadow\n          ctx.shadowColor = 'rgba(0, 0, 0, 0.5)';\n          ctx.shadowBlur = 10;\n          ctx.shadowOffsetX = 3;\n          ctx.shadowOffsetY = 4;\n\n          ctx.beginPath();\n          ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);\n          ctx.fillStyle = grad;\n          ctx.fill();\n\n          // Reset shadow for label\n          ctx.shadowColor = 'transparent';\n\n          // Atomic symbol inside sphere for educational context\n          ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';\n          ctx.font = `bold ${Math.floor(this.radius * 0.65)}px sans-serif`;\n          ctx.textAlign = 'center';\n          ctx.textBaseline = 'middle';\n          ctx.fillText(this.label, this.x, this.y + 1);\n\n          ctx.restore();\n        }\n      }\n\n      // Initialize Lattice Grid\n      function initParticles() {\n        particles = [];\n        const marginX = width * 0.12;\n        const marginY = height * 0.14;\n        const usableW = width - marginX * 2;\n        const usableH = height - marginY * 2;\n        const stepX = usableW / (COLS - 1);\n        const stepY = usableH / (ROWS - 1);\n\n        for (let r = 0; r < ROWS; r++) {\n          for (let c = 0; c < COLS; c++) {\n            const bx = marginX + c * stepX;\n            const by = marginY + r * stepY;\n\n            let type = 'iron';\n            if (currentMaterial === 'salt') {\n              // Alternating Sodium (Na+) and Chlorine (Cl-) ions in a cubic crystal lattice\n              type = (r + c) % 2 === 0 ? 'na' : 'cl';\n            }\n\n            particles.push(new Particle(c, r, bx, by, type));\n          }\n        }\n      }\n\n      // Draw Flexible Chemical Bonds (Springs) between neighbors\n      function drawLatticeBonds() {\n        ctx.save();\n        ctx.strokeStyle = 'rgba(255, 255, 255, 0.15)';\n        ctx.lineWidth = 1.5;\n\n        for (let i = 0; i < particles.length; i++) {\n          const p1 = particles[i];\n          // Connect to right neighbor\n          if (p1.col < COLS - 1) {\n            const p2 = particles[i + 1];\n            ctx.beginPath();\n            ctx.moveTo(p1.x, p1.y);\n            ctx.lineTo(p2.x, p2.y);\n            ctx.stroke();\n          }\n          // Connect to bottom neighbor\n          if (p1.row < ROWS - 1) {\n            const p2 = particles[i + COLS];\n            ctx.beginPath();\n            ctx.moveTo(p1.x, p1.y);\n            ctx.lineTo(p2.x, p2.y);\n            ctx.stroke();\n          }\n        }\n        ctx.restore();\n      }\n\n      // Animation Loop\n      let animTime = 0;\n      function animate() {\n        animTime += 1;\n        ctx.clearRect(0, 0, width, height);\n\n        // 1. Draw Bonds (if enabled)\n        if (showBonds) {\n          drawLatticeBonds();\n        }\n\n        // 2. Draw Anchors (Home Bases)\n        if (showAnchors) {\n          for (let p of particles) {\n            p.drawAnchor(ctx);\n          }\n        }\n\n        // 3. Draw Trails (Motion Paths)\n        if (showTrails) {\n          for (let i = 0; i < particles.length; i++) {\n            const isSpotlighted = showSpotlight && i === spotlightIndex;\n            particles[i].drawTrail(ctx, isSpotlighted);\n          }\n        }\n\n        // 4. Update and Draw Particles\n        for (let i = 0; i < particles.length; i++) {\n          const p = particles[i];\n          p.update(animTime);\n\n          const isSpotlighted = showSpotlight && i === spotlightIndex;\n          const isMuted = showSpotlight && !isSpotlighted;\n          p.draw(ctx, isSpotlighted, isMuted);\n        }\n\n        // If dragging, draw elastic rubber band back to home base\n        if (draggedParticle) {\n          ctx.save();\n          ctx.beginPath();\n          ctx.moveTo(draggedParticle.baseX, draggedParticle.baseY);\n          ctx.lineTo(draggedParticle.x, draggedParticle.y);\n          ctx.strokeStyle = '#f43f5e';\n          ctx.lineWidth = 3;\n          ctx.setLineDash([5, 5]);\n          ctx.stroke();\n\n          // Draw returning arrow prompt\n          ctx.fillStyle = '#f43f5e';\n          ctx.font = 'bold 12px sans-serif';\n          ctx.fillText(\"Force pulling home!\", (draggedParticle.x + draggedParticle.baseX)/2, (draggedParticle.y + draggedParticle.baseY)/2 - 10);\n          ctx.restore();\n        }\n\n        requestAnimationFrame(animate);\n      }\n\n      // --- EVENT HANDLERS & INTERACTIONS ---\n\n      // Handle Resize dynamically\n      function handleResize() {\n        width = canvas.width = container.clientWidth;\n        height = canvas.height = container.clientHeight;\n        initParticles();\n      }\n      window.addEventListener('resize', handleResize);\n\n      // Temperature slider\n      const tempSlider = document.getElementById('tempSlider');\n      const tempDisplay = document.getElementById('tempDisplay') || document.getElementById('temp-display');\n      const hudStatus = document.getElementById('hud-status');\n\n      tempSlider.addEventListener('input', (e) => {\n        temperature = parseInt(e.target.value);\n        if (temperature < 15) {\n          tempDisplay.textContent = `Very Cold (${temperature - 40}°C)`;\n          hudStatus.textContent = \"Status: SLOW GENTLE SHIVER\";\n        } else if (temperature < 65) {\n          tempDisplay.textContent = `Room Temp (${temperature - 15}°C)`;\n          hudStatus.textContent = \"Status: LIVELY JIGGLING IN PLACE\";\n        } else {\n          tempDisplay.textContent = `Hot Solid (${temperature + 50}°C)`;\n          hudStatus.textContent = \"Status: RAPID ENERGETIC BUZZING\";\n        }\n      });\n\n      // Material Switcher\n      const btnIron = document.getElementById('btn-iron');\n      const btnSalt = document.getElementById('btn-salt');\n\n      btnIron.addEventListener('click', () => {\n        if (currentMaterial === 'iron') return;\n        currentMaterial = 'iron';\n        btnIron.classList.add('active');\n        btnSalt.classList.remove('active');\n        initParticles();\n      });\n\n      btnSalt.addEventListener('click', () => {\n        if (currentMaterial === 'salt') return;\n        currentMaterial = 'salt';\n        btnSalt.classList.add('active');\n        btnIron.classList.remove('active');\n        initParticles();\n      });\n\n      // Visual Feature Toggles\n      function setupToggle(btnId, currentState, callback) {\n        const btn = document.getElementById(btnId);\n        const indicator = btn.querySelector('.status-indicator');\n        btn.addEventListener('click', () => {\n          const newState = callback();\n          if (newState) {\n            btn.classList.add('active');\n            indicator.textContent = 'ON';\n          } else {\n            btn.classList.remove('active');\n            indicator.textContent = 'OFF';\n          }\n        });\n      }\n\n      setupToggle('toggleTrails', showTrails, () => {\n        showTrails = !showTrails;\n        return showTrails;\n      });\n\n      setupToggle('toggleAnchors', showAnchors, () => {\n        showAnchors = !showAnchors;\n        return showAnchors;\n      });\n\n      setupToggle('toggleBonds', showBonds, () => {\n        showBonds = !showBonds;\n        return showBonds;\n      });\n\n      setupToggle('toggleSpotlight', showSpotlight, () => {\n        showSpotlight = !showSpotlight;\n        return showSpotlight;\n      });\n\n      // Canvas Pointer Events (Pull / Push particle test)\n      function getCanvasCoords(evt) {\n        const rect = canvas.getBoundingClientRect();\n        return {\n          x: (evt.clientX - rect.left) * (canvas.width / rect.width),\n          y: (evt.clientY - rect.top) * (canvas.height / rect.height)\n        };\n      }\n\n      function findClosestParticle(x, y) {\n        let closest = null;\n        let minDist = 9999;\n        particles.forEach((p, idx) => {\n          const dist = Math.hypot(p.x - x, p.y - y);\n          if (dist < minDist) {\n            minDist = dist;\n            closest = { particle: p, index: idx, dist };\n          }\n        });\n        return closest;\n      }\n\n      canvas.addEventListener('mousedown', (e) => {\n        const pos = getCanvasCoords(e);\n        mousePos = pos;\n        isMouseDown = true;\n        const res = findClosestParticle(pos.x, pos.y);\n        if (res && res.dist < res.particle.radius * 2.2) {\n          draggedParticle = res.particle;\n          spotlightIndex = res.index;\n        }\n      });\n\n      window.addEventListener('mousemove', (e) => {\n        if (!isMouseDown) return;\n        mousePos = getCanvasCoords(e);\n      });\n\n      window.addEventListener('mouseup', () => {\n        isMouseDown = false;\n        if (draggedParticle) {\n          // Snap release velocity\n          draggedParticle.vx = (draggedParticle.baseX - draggedParticle.x) * 0.4;\n          draggedParticle.vy = (draggedParticle.baseY - draggedParticle.y) * 0.4;\n          draggedParticle = null;\n        }\n      });\n\n      // Touch events for mobile compatibility\n      canvas.addEventListener('touchstart', (e) => {\n        if (e.touches.length > 0) {\n          const touch = e.touches[0];\n          const pos = getCanvasCoords(touch);\n          mousePos = pos;\n          isMouseDown = true;\n          const res = findClosestParticle(pos.x, pos.y);\n          if (res && res.dist < res.particle.radius * 2.5) {\n            draggedParticle = res.particle;\n            spotlightIndex = res.index;\n          }\n        }\n      }, { passive: true });\n\n      canvas.addEventListener('touchmove', (e) => {\n        if (e.touches.length > 0 && isMouseDown) {\n          mousePos = getCanvasCoords(e.touches[0]);\n        }\n      }, { passive: true });\n\n      canvas.addEventListener('touchend', () => {\n        isMouseDown = false;\n        if (draggedParticle) {\n          draggedParticle = null;\n        }\n      });\n\n      // --- VOCABULARY MODAL INTERACTION ---\n      const modal = document.getElementById('vocabModal');\n      const mIcon = document.getElementById('m-icon');\n      const mTitle = document.getElementById('m-title');\n      const mDesc = document.getElementById('m-desc');\n      const mTakeaway = document.getElementById('m-takeaway');\n      const closeModal = document.getElementById('closeModal');\n\n      document.querySelectorAll('.vocab-btn').forEach(btn => {\n        btn.addEventListener('click', () => {\n          const key = btn.getAttribute('data-vocab');\n          const data = vocabData[key];\n          if (data) {\n            mIcon.textContent = data.icon;\n            mTitle.textContent = data.title;\n            mDesc.textContent = data.desc;\n            mTakeaway.textContent = data.takeaway;\n            modal.classList.add('active');\n          }\n        });\n      });\n\n      closeModal.addE